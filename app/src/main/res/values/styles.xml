<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      ~ See also drawable-v21/mtrl_popupmenu_background.xml and
      ~ drawable-v23/mtrl_popupmenu_background_dark.xml which are overridden.
      -->
    <style name="Widget.WizeFiles.ListView.DropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="TextAppearance.AppCompat.Widget.ActionBar.Subtitle.Small">
        <item name="android:textSize" tools:ignore="SpUsage">12dp</item>
    </style>

    <style name="Widget.WizeFiles.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="android:stateListAnimator">@null</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mtrl_btn_stroke_color_selector</item>
        <item name="strokeWidth">@dimen/mtrl_btn_stroke_size</item>
    </style>

    <!-- See also ThemeOverlay.AppCompat.ActionBar . -->
    <style name="ThemeOverlay.WizeFiles.ActionBar" parent="">
        <item name="colorControlNormal">?android:textColorPrimary</item>
        <item name="searchViewStyle">@style/Widget.AppCompat.SearchView.ActionBar</item>
    </style>

    <style name="ThemeOverlay.WizeFiles.ActionBarPopup" parent="">
        <item name="colorControlNormal">?android:textColorSecondary</item>
        <item name="searchViewStyle">@style/Widget.AppCompat.SearchView</item>
    </style>

    <style name="Widget.WizeFiles.StorageCleaner.ActionButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_storage_cleaner_action_button</item>
        <item name="android:textColor">@color/storage_cleaner_action_button_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>


    <style name="ShapeAppearanceOverlay.WizeFiles.FileProperties.Section" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlay.WizeFiles.FileProperties.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundTint">?colorSurfaceContainerLow</item>
    </style>

    <style name="Widget.WizeFiles.FileProperties.CompactTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.WizeFiles.FileProperties.CompactTextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

</resources>

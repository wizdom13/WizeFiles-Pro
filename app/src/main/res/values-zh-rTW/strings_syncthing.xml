    <string name="syncthing_restore_confirm">還原 %1$s 在 %2$s 的版本？這將取代目前檔案。下次同步可能將還原的檔案傳送到其他裝置。</string>
    <string name="syncthing_backup_title">Syncthing 匯入與備份</string>
    <string name="syncthing_backup_help">匯入加密的 WizeFiles 備份、config.xml 或 Syncthing 設定 ZIP。備份包含設定與裝置身分，不包含檔案、保留的檔案版本或同步歷程。</string>
    <string name="syncthing_import">匯入設定</string>
    <string name="syncthing_export">匯出加密備份</string>
    <string name="syncthing_backup_saved">加密備份已儲存並驗證</string>
    <string name="syncthing_backup_password">備份密碼</string>
    <string name="syncthing_confirm_password">確認密碼</string>
    <string name="syncthing_password_help">請使用至少 12 個字元，並兩次輸入相同密碼。請妥善保管，密碼無法復原。</string>
    <string name="syncthing_decrypt_help">輸入用來加密此備份的密碼。</string>
    <string name="syncthing_import_preview">匯入預覽：%1$d 個裝置 · %2$d 個資料夾</string>
    <string name="syncthing_import_help">檢查每個本機路徑。匯入的資料夾初始為暫停狀態。僅匯入相容設定，不匯入 GUI 認證、自動升級或介紹者行為。</string>
    <string name="syncthing_original_id">原裝置 ID：%1$s</string>
    <string name="syncthing_choose_original">選取原裝置</string>
    <string name="syncthing_preserve_identity">保留原裝置身分</string>
    <string name="syncthing_missing_identity">原私密金鑰無法取得。將使用本應用程式的身分，請在其他裝置上配對。</string>
    <string name="syncthing_identity_warning">在此使用原身分之前，請停止原 Syncthing 應用程式。否則本應用程式會保留目前身分，並需要在其他裝置上配對。</string>
    <string name="syncthing_map_folder">選取本機資料夾</string>
    <string name="syncthing_replace_confirm">取代目前的 Syncthing 設定？匯入提交後，現有設定檔及其歷程記錄將移除。本機檔案會保留。啟用前請檢查匯入的資料夾。</string>
    <string name="syncthing_import_complete">匯入完成。裝置 ID：%1$s。匯入的資料夾已暫停，準備好後逐一啟用。</string>

<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_interface_title">

        <com.wisso.wizefiles.settings.LocalePreference
            android:key="@string/pref_key_locale"
            android:title="@string/settings_locale_title"
            android:summary="@string/settings_locale_summary" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_night_mode"
            android:title="@string/settings_night_mode_title"
            android:defaultValue="@string/pref_default_value_night_mode"
            android:entries="@array/settings_night_mode_entries"
            android:entryValues="@array/pref_entry_values_night_mode"
            android:summary="@string/settings_night_mode_summary"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_black_night_mode"
            android:title="@string/settings_black_night_mode"
            android:defaultValue="@bool/pref_default_value_black_night_mode"
            android:summary="@string/settings_black_night_mode_summary" />

        <com.wisso.wizefiles.settings.IconShapePreference
            android:key="@string/pref_key_file_icon_shape"
            android:title="@string/settings_icon_shape_title"
            android:defaultValue="@string/pref_default_value_file_icon_shape"
            android:entries="@array/settings_icon_shape_entries"
            android:entryValues="@array/pref_entry_values_file_icon_shape"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_file_list_animation"
            android:title="@string/settings_file_list_animation_title"
            android:defaultValue="@bool/pref_default_value_file_list_animation"
            android:summary="@string/settings_file_list_animation_summary" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_file_name_ellipsize"
            android:title="@string/settings_file_name_ellipsize_title"
            android:defaultValue="@string/pref_default_value_file_name_ellipsize"
            android:entries="@array/settings_file_name_ellipsize_entries"
            android:entryValues="@array/pref_entry_values_file_name_ellipsize"
            android:summary="@string/settings_file_name_ellipsize_summary"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_behavior_title">

        <SwitchPreferenceCompat
            android:key="@string/pref_key_indexed_search"
            android:title="@string/settings_indexed_search_title"
            android:defaultValue="@bool/pref_default_value_indexed_search"
            android:summary="@string/settings_indexed_search_summary" />

        <Preference
            android:key="@string/pref_key_search_index_status"
            android:title="@string/settings_search_index_status_title"
            android:summary="@string/settings_search_index_status_preparing" />

        <com.wisso.wizefiles.settings.DefaultDirectoryPreference
            android:key="@string/pref_key_file_list_default_directory"
            android:title="@string/settings_default_directory_title"
            android:summary="@string/settings_default_directory_summary"
            app:useSimpleSummaryProvider="true" />

        <com.wisso.wizefiles.settings.StoragesPreference
            android:title="@string/settings_storages_title"
            android:summary="@string/settings_storages_summary_empty" />

        <com.wisso.wizefiles.settings.StandardDirectoriesPreference
            android:title="@string/settings_standard_directories_title"
            android:summary="@string/settings_standard_directories_summary_empty" />

        <com.wisso.wizefiles.settings.BookmarkDirectoriesPreference
            android:title="@string/settings_bookmark_directories_title"
            android:summary="@string/settings_bookmark_directories_summary_empty" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_recycle_bin"
            android:title="@string/settings_recycle_bin_title"
            android:defaultValue="@bool/pref_default_value_recycle_bin"
            android:summary="@string/settings_recycle_bin_summary" />

        <com.wisso.wizefiles.settings.RootStrategyPreference
            android:key="@string/pref_key_root_strategy"
            android:title="@string/settings_root_strategy_title"
            android:defaultValue="@string/pref_default_value_root_strategy"
            android:entries="@array/settings_root_strategy_entries"
            android:entryValues="@array/pref_entry_values_root_strategy"
            android:summary="@string/settings_root_strategy_summary"
            app:useSimpleSummaryProvider="true" />

        <com.wisso.wizefiles.settings.CharsetPreference
            android:key="@string/pref_key_archive_file_name_encoding"
            android:title="@string/settings_archive_file_name_encoding_title"
            android:defaultValue="@string/pref_default_value_archive_file_name_encoding"
            android:summary="@string/settings_archive_file_name_encoding_summary"
            app:useSimpleSummaryProvider="true" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_open_apk_default_action"
            android:title="@string/settings_open_apk_default_action_title"
            android:defaultValue="@string/pref_default_value_open_apk_default_action"
            android:entries="@array/settings_open_apk_default_action_entries"
            android:entryValues="@array/pref_entry_values_open_apk_default_action"
            android:summary="@string/settings_open_apk_default_action_summary"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_show_pdf_thumbnail_pre_28"
            android:title="@string/settings_show_pdf_thumbnail_pre_28_title"
            android:defaultValue="@bool/pref_default_value_show_pdf_thumbnail_pre_28"
            android:summary="@string/settings_show_pdf_thumbnail_pre_28_summary"
            app:isPreferenceVisible="@bool/pref_visible_show_pdf_thumbnail_pre_28" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_read_remote_files_for_thumbnail"
            android:title="@string/settings_read_remote_files_for_thumbnail_title"
            android:defaultValue="@bool/pref_default_value_read_remote_files_for_thumbnail"
            android:summary="@string/settings_read_remote_files_for_thumbnail_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_security_title">

        <Preference
            android:key="@string/pref_key_security_password"
            android:title="@string/settings_security_password_title"
            android:summary="@string/settings_security_password_summary" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_protect_browser"
            android:title="@string/settings_security_protect_browser_title"
            android:defaultValue="false"
            android:summary="@string/settings_security_protect_browser_summary" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_enable_biometric"
            android:title="@string/settings_security_enable_biometric_title"
            android:defaultValue="false"
            android:summary="@string/settings_security_enable_biometric_summary" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_time_to_relock"
            android:title="@string/settings_security_time_to_relock_title"
            android:defaultValue="@string/pref_default_value_time_to_relock"
            android:entries="@array/settings_security_relock_entries"
            android:entryValues="@array/pref_entry_values_security_relock"
            android:summary="@string/settings_security_time_to_relock_summary"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_backup_restore_title">

        <Preference
            android:key="@string/pref_key_backup_settings"
            android:title="@string/settings_backup_settings_title"
            android:summary="@string/settings_backup_settings_summary" />

        <Preference
            android:key="@string/pref_key_restore_settings"
            android:title="@string/settings_restore_settings_title"
            android:summary="@string/settings_restore_settings_summary" />
    </PreferenceCategory>
</PreferenceScreen>

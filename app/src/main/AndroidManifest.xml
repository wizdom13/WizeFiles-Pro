            android:exported="false"
            android:label="@string/batch_rename_title"
            android:theme="@style/Theme.WizeFiles" />

        <activity
            android:name="com.wisso.wizefiles.feature.filebrowser.EditFileActivity"
            android:autoRemoveFromRecents="true"
            android:icon="@drawable/ic_edit"
            android:label="@string/file_edit_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.feature.filebrowser.OpenFileAsDialogActivity"
            android:autoRemoveFromRecents="true"
            android:icon="@drawable/ic_open_as"
            android:label="@string/file_open_as_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.storage.AddStorageDialogActivity"
            android:label="@string/storage_add_storage_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.storage.EditDeviceStorageDialogActivity"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/storage_edit_device_storage_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.storage.AddExternalStorageShortcutActivity"
            android:label="@string/storage_add_external_storage_shortcut_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.storage.EditExternalStorageShortcutDialogActivity"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/storage_edit_external_storage_shortcut_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.storage.AddDocumentTreeActivity"
            android:label="@string/storage_add_document_tree_title"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.storage.EditRcloneStorageActivity"

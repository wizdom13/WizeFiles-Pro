            android:theme="@style/Theme.WizeFiles" />

        <activity
            android:name="com.wisso.wizefiles.feature.webdocument.WebDocumentViewerActivity"
            android:exported="false"
            android:label="@string/web_document_viewer_title"
            android:theme="@style/Theme.WizeFiles" />

        <activity
            android:name="com.wisso.wizefiles.feature.audioplayer.AudioPlayerActivity"
            android:exported="false"
            android:label="@string/audio_player_title"
            android:theme="@style/Theme.WizeFiles" />

        <activity
            android:name="com.wisso.wizefiles.feature.audioplayer.SetRingtoneActivity"
            android:exported="false"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <service
            android:name="com.wisso.wizefiles.feature.audioplayer.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <activity
            android:name="com.wisso.wizefiles.feature.filebrowser.OpenFileActivity"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.WizeFiles.Translucent">
            <intent-filter>
                <action android:name="com.wisso.wizefiles.intent.action.OPEN_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity

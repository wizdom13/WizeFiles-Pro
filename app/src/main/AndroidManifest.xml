            android:theme="@style/Theme.WizeFiles" />

        <activity
            android:name="com.wisso.wizefiles.vault.AddVaultDialogActivity"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/navigation_add_vault"
            android:theme="@style/Theme.WizeFiles.Translucent" />

        <activity
            android:name="com.wisso.wizefiles.vault.VaultActivity"

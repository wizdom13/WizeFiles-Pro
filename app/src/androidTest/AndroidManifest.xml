<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="com.wisso.wizefiles.testsupport.HostileDocumentProvider"
            android:authorities="${applicationId}.hostile_documents"
            android:exported="true"
            android:grantUriPermissions="true" />
        <activity
            android:name="com.wisso.wizefiles.testsupport.ExternalEditProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
